# Copy to .env and replace the placeholders:  cp .env.example .env
# .env is git-ignored. Never commit real credentials.
#
# This file is read by docker compose and by the Makefile (which exports it to
# `make run-api` and `make test`). Use KEY=value with no quotes or spaces.

# --- Local infrastructure (docker compose) ---------------------------------
POSTGRES_USER=hookrelay
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=hookrelay
POSTGRES_PORT=5432

REDIS_PASSWORD=change-me-redis
REDIS_PORT=6379

# --- Application ------------------------------------------------------------
# development | test | production
HOOKRELAY_ENV=development
# debug | info | warn | error
HOOKRELAY_LOG_LEVEL=info
HOOKRELAY_HTTP_ADDR=:8080
HOOKRELAY_SHUTDOWN_TIMEOUT=20s

# Delivery timing (worker). Must satisfy:
#   DELIVERY_LEASE > TASK_TIMEOUT > DELIVERY_HTTP_TIMEOUT
HOOKRELAY_DELIVERY_HTTP_TIMEOUT=10s
HOOKRELAY_TASK_TIMEOUT=30s
HOOKRELAY_DELIVERY_LEASE=60s
# Delivery tasks one worker process runs concurrently (1-1000).
HOOKRELAY_WORKER_CONCURRENCY=50

# Dispatcher: poll Postgres for due deliveries every INTERVAL (max 1m), up to
# BATCH_SIZE per batch (1-10000). DISPATCH_LEASE (min 30s): how long a delivery
# may wait in 'queued' for a worker before the reaper re-dispatches it.
HOOKRELAY_DISPATCH_INTERVAL=500ms
HOOKRELAY_DISPATCH_BATCH_SIZE=500
HOOKRELAY_DISPATCH_LEASE=5m
# Reaper: recover stale queued / expired in-flight deliveries every INTERVAL,
# up to BATCH_SIZE of each per pass (1-10000).
HOOKRELAY_REAPER_INTERVAL=30s
HOOKRELAY_REAPER_BATCH_SIZE=500

# SSRF protection: endpoint URLs may not point at private/internal addresses.
# Set to true ONLY for local development against a local receiver
# (e.g. http://localhost:9000/hook). Refused in production.
HOOKRELAY_ALLOW_PRIVATE_TARGETS=false

# AES-256-GCM key for endpoint signing secrets: base64 of exactly 32 bytes.
# `make env` fills this in for you; otherwise generate with: openssl rand -base64 32
# Losing or changing this key makes stored endpoint secrets unreadable.
HOOKRELAY_ENCRYPTION_KEY=replace-with-output-of-openssl-rand-base64-32

# Connection URLs. These reference the values above. If your password has
# URL-special characters (@ : / ? #), percent-encode it here.
#
# Neon: `neon deploy` / `neon env pull` overwrite DATABASE_URL with the branch's
# POOLED URL and add DATABASE_URL_UNPOOLED (direct). The app uses the pooled
# URL, and `hookrelay migrate` uses the direct one. Without Neon, leave
# DATABASE_URL_UNPOOLED unset and DATABASE_URL is used for both.
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable
# DATABASE_URL_UNPOOLED=
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:${REDIS_PORT}/0

# --- Tests ------------------------------------------------------------------
# Integration tests run only when these are set; otherwise they are skipped.
# Tests CREATE and DROP databases on this server, so keep it pointed at the
# local docker Postgres (never at Neon production; pgtest refuses that).
TEST_DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable
TEST_REDIS_URL=${REDIS_URL}
